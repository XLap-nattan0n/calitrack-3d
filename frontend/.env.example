# Public values only — never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Go API origin the Next dev/prod server proxies /api/v1/* to (server-side only)
API_PROXY_TARGET=http://localhost:8080
# Set to "true" to mock plan saving until the Plans API (M3.2) is merged
NEXT_PUBLIC_MOCK_PLANS=true
