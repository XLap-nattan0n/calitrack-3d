# Public values only — never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Go API origin the Next server proxies /api/v1/* to (server-side only; the browser calls same-origin /api/v1)
API_PROXY_TARGET=http://localhost:8080
# Set to "true" only to mock plan saving without the API; the Plans API is merged, so leave it false
NEXT_PUBLIC_MOCK_PLANS=false
