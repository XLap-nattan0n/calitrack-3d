# Copy to .env for local backend runs. Never commit real values.
# Frontend variables live in frontend/.env.example.
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/calitrack
# SUPABASE_JWT_ISSUER is required; set SUPABASE_JWT_SECRET (HS256) and/or SUPABASE_JWKS_URL (RS256/ES256)
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
